__pycache__/
*.pyc
.DS_Store

# rebuilt on demand
utp/packs/sample/build/
vulcan-conlang/lab/
vulcan-conlang/course/*.html

# the desktop shell's tools and installers
desktop/node_modules/
desktop/dist/

